{
  "name": "@ideaconsult/qubounds-viewer",
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "description": "Embeddable React viewer for conformal prediction intervals (qu-bounds).",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideaconsult/qubounds-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/ideaconsult/qubounds-viewer/issues"
  },
  "homepage": "https://github.com/ideaconsult/qubounds-viewer#readme",
  "keywords": [
    "conformal-prediction",
    "qubounds",
    "react",
    "viewer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/qubounds-viewer.js",
  "module": "./dist/qubounds-viewer.js",
  "exports": {
    ".": {
      "import": "./dist/qubounds-viewer.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "prepublishOnly": "pnpm test && pnpm build:lib",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "vite": "^6.4.3",
    "vitest": "^4.1.9"
  }
}
